 ASR_API int launch_linear(const float* x, const float* w, const float* bias, float* y,
                           int M, int N, int K, int act, cudaStream_t stream) {
-  dim3 block(TILE, TILE);
-  dim3 grid(ceil_div(N, TILE), ceil_div(M, TILE));
